# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed.

# Supabase project (Settings -> API in the Supabase dashboard). The
# service_role key is server-only — never expose it to the client, never
# prefix it with NEXT_PUBLIC_. Use a project dedicated to Betalight, not
# the Maven Enterprise project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Public site URL, used for canonical links, sitemap.xml and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.betalightenterprises.co.ke

# WhatsApp number for the floating chat button, in international format
# without the leading +.
NEXT_PUBLIC_WHATSAPP_NUMBER=254735807904

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to
# disable analytics — the cookie consent banner will not load GA4 without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
